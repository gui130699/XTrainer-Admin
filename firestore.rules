rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/system/config).data.adminUid == request.auth.uid; }
    function ownsExisting() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function createsForSelf() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    function preservesOwner() { return request.resource.data.ownerId == resource.data.ownerId; }

    match /system/config {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/system/config);
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && (request.resource.data.role == 'user' || (!exists(/databases/$(database)/documents/system/config) && request.resource.data.role == 'admin'));
      allow update: if signedIn() && request.auth.uid == uid && (request.resource.data.role == resource.data.role || (!exists(/databases/$(database)/documents/system/config) && request.resource.data.role == 'admin'));
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /workouts/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf();
      allow update: if ownsExisting() && preservesOwner();
      allow delete: if ownsExisting();
    }
    match /workoutSessions/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf();
      allow update: if ownsExisting() && preservesOwner();
      allow delete: if ownsExisting();
    }
    match /bodyWeights/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf();
      allow update: if ownsExisting() && preservesOwner();
      allow delete: if ownsExisting();
    }
    match /physicalAssessments/{id} {
      allow read: if ownsExisting();
      allow create: if createsForSelf();
      allow update: if ownsExisting() && preservesOwner();
      allow delete: if ownsExisting();
    }
    match /auditLogs/{id} { allow read, create: if isAdmin(); }
  }
}
